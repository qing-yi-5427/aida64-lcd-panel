<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- AIDA64 RemoteSensor commonly runs on a private LAN over plain HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
